# Скопируй этот файл в .env и впиши свои значения.
# Файл .env НЕ попадает в Git — секреты храни только в нём.
# Это настройки для КОМПЬЮТЕРА РАЗРАБОТЧИКА. Что задать на сервере — в DEPLOY.md.

# Docker на компьютере: к docker-compose.yml добавлять docker-compose.dev.yml
# (порты базы, Redis, RabbitMQ и режим разработки). Тогда хватает  docker compose up --build
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml
APP_ENV=development

# Адреса для запуска сервера и бота на компьютере (база и Redis — в Docker).
DATABASE_URL=postgresql+psycopg://geek:geek@localhost:5433/geek_season
TEST_DATABASE_URL=postgresql+psycopg://geek:geek@localhost:5433/geek_test
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://geek:geek@localhost:5672/

# Telegram-бот: создай его у @BotFather командой /newbot.
BOT_TOKEN=
BOT_USERNAME=

# Telegram ID администраторов через запятую (узнать свой ID — бот @userinfobot).
# Админ может добавлять, менять и убирать задачи (страница «Редактор» на сайте).
ADMIN_TELEGRAM_IDS=

# Ключ подписи токенов входа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Адрес Telegram Bot API — менять не нужно (другой адрес — для тестов).
# TELEGRAM_API_URL=https://api.telegram.org

# Длительность пробника в минутах (на ЕГЭ — 235).
# EXAM_DURATION_MINUTES=5

# Картинки и файлы к задачам: папка и ограничения на размер (МБ).
# UPLOAD_DIR=uploads
# MAX_IMAGE_MB=5
# MAX_ATTACHMENT_MB=20

# --- Только для сервера (см. DEPLOY.md) ---
# APP_ENV=production            — тогда обязателен свой JWT_SECRET (от 32 символов)
# CORS_ORIGINS=https://geek-season.github.io   — адрес сайта, если он не на том же адресе, что API
# DB_PASSWORD=...               — пароль PostgreSQL (задаётся при первом создании базы)
# RABBITMQ_PASSWORD=...         — пароль RabbitMQ
